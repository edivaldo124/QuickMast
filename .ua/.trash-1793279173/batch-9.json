 "nodes": [
  {
   "id": "file:templates/_componentes.html",
   "type": "file",
   "name": "_componentes.html",
   "filePath": "templates/_componentes.html",
   "summary": "Biblioteca de macros Jinja reutilizáveis (logo, barra superior, banner, campo de formulário, grelha do úbere, legenda, esqueletos, painel da marca e link de voltar) espelhando a página Componentes do Figma.",
   "tags": [
    "jinja",
    "macros",
    "componentes",
    "ui",
    "acessibilidade"
   ],
   "complexity": "moderate",
   "languageNotes": "Usa macros Jinja2 com {% call %}/caller() para envolver o corpo de um campo, e controlo de espaço em branco com -%} e {%- para gerar HTML limpo."
  },
  {
