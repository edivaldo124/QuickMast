   "type": "function",
   "name": "logo_inicio",
   "filePath": "templates/_componentes.html",
   "lineRange": [
    6,
    20
   ],
   "summary": "Gera o logotipo do início em SVG inline (placa verde com quatro tetos e o alerta vermelho) para que os tetos possam animar-se um a um e inclinar-se com o rato (data-tilt).",
   "tags": [
    "svg",
    "logotipo",
    "animacao",
    "macro"
   ],
   "complexity": "simple"
  },
