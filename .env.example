# Modelo de configuração do QuickMast. Copie para .env e preencha:
#   cp .env.example .env && chmod 600 .env
# O .env é lido pelo servidor.py (python-dotenv) e pelo docker compose. NÃO o partilhe.

# Assina o cookie de sessão. Gerar: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL (docker-compose.yml). Atenção: o Postgres só aplica estes valores na
# 1.ª criação do volume; para mudar a senha depois use ALTER USER no banco.
POSTGRES_USER=quickmast
POSTGRES_PASSWORD=
POSTGRES_DB=quickmast
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}

# 1 se usar HTTPS
COOKIE_SEGURO=0
# 0 para desligar o registo público
PERMITIR_REGISTO=1

# Admin inicial: criado no arranque se o email ainda não existir. A senha vai para o
# banco só como hash (scrypt); depois do 1.º arranque pode apagar ADMIN_SENHA daqui.
# Gerar uma senha: python3 -c "import secrets; print(secrets.token_urlsafe(12))"
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@quickmast.local
ADMIN_SENHA=
