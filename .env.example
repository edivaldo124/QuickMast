# Modelo de configuração do QuickMast. Copie para .env e preencha:
#   cp .env.example .env && chmod 600 .env
# O .env é lido pelo servidor.py (python-dotenv) e pelo docker compose. NÃO o partilhe.

# Assina o cookie de sessão. Gerar: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL (docker-compose.yml). Atenção: o Postgres só aplica estes valores na
# 1.ª criação do volume; para mudar a senha depois use ALTER USER no banco.
# POSTGRES_USER é o dono do banco (superuser no container): a aplicação NÃO o usa.
POSTGRES_USER=quickmast
POSTGRES_PASSWORD=
POSTGRES_DB=quickmast
# Dono do banco: só o "flask --app servidor iniciar" o usa (criar/alterar tabelas e o utilizador da app)
DATABASE_URL_ADMIN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}
# Aplicação: só lê e escreve dados. O "iniciar" cria este utilizador com esta senha.
# Gerar a senha: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# (num .env antigo, com o dono no DATABASE_URL, basta correr: python3 configurar_banco_app.py)
APP_DB_PASSWORD=
DATABASE_URL=postgresql+psycopg2://quickmast_app:${APP_DB_PASSWORD}@localhost:5433/${POSTGRES_DB}

# 1 só no seu PC: liga o depurador do Werkzeug, que executa código. Em produção fica 0.
FLASK_DEBUG=0
# Cookie de sessão só por HTTPS. 0 apenas no seu PC (http://localhost); sem a linha, vale 1.
COOKIE_SEGURO=0
# 1 se o Flask estiver atrás do Nginx (usa o IP real do cliente no limite de tentativas)
ATRAS_DE_PROXY=0
# Registo público (1 = qualquer pessoa cria conta de operador). Sem a linha, vale 0.
PERMITIR_REGISTO=0
# Simulador do sensor em /read: 1 só no seu PC, sem o ESP8266. Em produção fica 0 (sem a linha, vale 0).
SIMULADOR_SENSOR=0
# Logs em JSON, uma linha por evento (padrão fora do modo debug). 0 = texto.
LOG_JSON=1

# Admin inicial: criado no arranque se o email ainda não existir. Aqui fica só o HASH
# da senha (scrypt), nunca a senha em texto. Para definir: python3 definir_senha_admin.py
# (pede a senha e escreve a linha abaixo). Manter as aspas simples: o hash tem '$'.
# No 1.º login o admin tem de ativar a verificação em dois passos (app autenticadora).
# Telemóvel perdido: flask --app servidor redefinir-mfa EMAIL
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@quickmast.local
ADMIN_SENHA_HASH=
