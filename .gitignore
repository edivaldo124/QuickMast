# Segredos: o .env nunca vai para o repositório (o modelo .env.example vai)
.env
.env.*
!.env.example

# Firmware: senhas do Wi-Fi e da conta da placa (o modelo configuracao.example.h vai)
firmware/**/configuracao.h

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Banco SQLite antigo (dados locais)
*.db
*.sqlite3

# IDE e sistema
.idea/
.vscode/
.DS_Store

# Front-end da página inicial (frontend/): as dependências instalam-se com npm ci.
# O build (stetic/landing e templates/_landing_assets.html) vai para o repositório:
# a TV box não tem Node.
frontend/node_modules/

# Saída gerada pelo graphify
graphify-out/

# Relatório de segurança: descreve falhas ainda abertas, não vai para o GitHub
RELATORIO_SEGURANCA.md

# Understand Anything (arquivos locais; o resto de .ua/ deve ser commitado)
.ua/intermediate/
.ua/diff-overlay.json
